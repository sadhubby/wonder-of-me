# Database (Turso in production, local SQLite file for development)
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Telegram gateway
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=

# Dashboard behavior
DASHBOARD_TIMEZONE=UTC
DAILY_CALORIE_TARGET=2200
DAILY_PROTEIN_TARGET=150
DAILY_CARBS_TARGET=250
DAILY_FAT_TARGET=70

# Outbound tiles (leave blank to show the setup state)
PORTFOLIO_URL=https://example.com
GARDEN_URL=https://example.com

# Public deployment URL used by the webhook helper script
APP_URL=https://your-dashboard.vercel.app

# Reserved for future live Spotify integration
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
